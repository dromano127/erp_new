# --- Neon (Postgres) ---
# Connection string da branch (obtida em: neonctl connection-string production
# --project-id sparkling-heart-63527951 --database-name neondb).
# NB: neste ambiente a porta 5432 é bloqueada — usamos SQL sobre HTTPS (@neondatabase/serverless).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.c-3.us-east-2.aws.neon.tech/neondb?sslmode=require

# neonctl / API Neon (para gerenciar projeto/branches)
NEON_API_KEY=napi_xxx
NEON_PROJECT_ID=sparkling-heart-63527951

# --- Tiny/Olist ERP API v3 (OAuth2 Authorization Code) ---
# Cadastrado em: ERP > configurações > geral > Aplicativos > + novo aplicativo
TINY_CLIENT_ID=
TINY_CLIENT_SECRET=
TINY_REDIRECT_URI=http://localhost:3000/callback
TINY_API_BASE=https://api.tiny.com.br/public-api/v3
TINY_AUTH_BASE=https://accounts.tiny.com.br/realms/tiny/protocol/openid-connect

# Throttle do sincronizador (req/s) — 1 é seguro em qualquer plano
SYNC_RATE_LIMIT=1
